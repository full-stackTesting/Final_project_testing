  "item": [
    {
      "name": "Register with valid complete data",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Generate a unique email each run so the test never collides with a previous run",
              "const uniqueEmail = `qa_user_${Date.now()}@automationtest.com`;",
              "pm.collectionVariables.set('registered_email', uniqueEmail);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const body = pm.response.json();",
              "",
              "pm.test('responseCode is 201 (User created)', function () {",
              "    pm.expect(body.responseCode).to.eql(201);",
              "});",
              "",
              "pm.test(\"message equals 'User created!'\", function () {",
              "    pm.expect(body.message).to.eql('User created!');",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
